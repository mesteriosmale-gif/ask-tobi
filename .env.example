# --------------------------------------------------
# GOOGLE GEMINI API KEY
# Chat fallback order: Gemini -> Groq -> OpenRouter -> Hugging Face
# --------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------
# OPENROUTER API KEY (100+ Models Access)
# --------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --------------------------------------------------
# GROQ API KEY (Ultra-Fast Models)
# --------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# --------------------------------------------------
# HUGGING FACE API KEY (Open-Source Vision/Video)
# --------------------------------------------------
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# --------------------------------------------------
# REPLICATE API KEY (Video & Image Models)
# --------------------------------------------------
REPLICATE_API_KEY=your_replicate_api_key_here

# --------------------------------------------------
# POLLINATIONS API KEY (Image Generation)
# Legacy POLLINATION_API_KEY is accepted by the server.
# --------------------------------------------------
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# --------------------------------------------------
# TOGETHER AI API KEY
# --------------------------------------------------
TOGETHER_API_KEY=your_together_api_key_here

# Set this to your public production origin before deploying.
SITE_URL=https://your-domain.com

# Authentication: create a MongoDB Atlas cluster and database user.
# Set either MONGODB_URL or MONGODB_URI. If both exist, MONGODB_URL takes precedence.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/liquid_sculpture?retryWrites=true&w=majority
AUTH_SECRET=generate_a_unique_secret_with_openssl_rand_base64_32

# Google OAuth credentials from Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set true when deploying behind a trusted reverse proxy outside Vercel.
AUTH_TRUST_HOST=false
